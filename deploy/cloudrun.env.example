# Copy to deploy/cloudrun.env and fill in. That file is gitignored; this one is
# committed, so never put a real project id, token or key here.

# ── project ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=replace-with-project-id
# "global" is served by aiplatform.googleapis.com; any region is served by its
# own host. Both work for Gemini.
GOOGLE_CLOUD_LOCATION=us-central1

NIMBUS_SERVICE=nimbus
NIMBUS_REPOSITORY=nimbus
NIMBUS_RUNTIME_SERVICE_ACCOUNT=nimbus-runtime@replace-with-project-id.iam.gserviceaccount.com
NIMBUS_ADMIN_SECRET=nimbus-admin-token

# ── model ────────────────────────────────────────────────────────────────
# "gemini"  -> publishers/google  ...:streamGenerateContent?alt=sse
# "mistral" -> publishers/mistralai ...:streamRawPredict
# "openai"  -> the OpenAI-compatible endpoint
#
# Mistral requires Model Garden access to be granted for the project. Verify
# with a real call before the session -- an unavailable model returns 404 at
# request time, and startup will still report healthy.
NIMBUS_GOOGLE_API_STYLE=gemini

# Two real tiers, so routing is a lever with a measurable effect. Leave
# NIMBUS_GOOGLE_MODEL_ID unset to use them.
NIMBUS_GOOGLE_MODEL_SMALL=gemini-2.5-flash-lite
NIMBUS_GOOGLE_MODEL_LARGE=gemini-2.5-flash

# Gemini 2.5 thinks before answering, and thinking spends the SAME output-token
# budget the answer needs. At NIMBUS_MAX_TOKENS=32 with thinking enabled the
# model returns NO TEXT AT ALL (finishReason MAX_TOKENS, thoughtsTokenCount 29)
# while latency and cost still look healthy. 0 disables it. Use "none" to omit
# the field entirely -- required for gemini-2.5-pro, which rejects a 0 budget.
NIMBUS_GEMINI_THINKING_BUDGET=0

# ── Cloud Run shape ──────────────────────────────────────────────────────
NIMBUS_MIN_INSTANCES=1
NIMBUS_MAX_INSTANCES=1
NIMBUS_CPU=1
NIMBUS_MEMORY=1Gi

# How many requests Cloud Run lets INTO the container. This must stay well above
# NIMBUS_MAX_CONCURRENT below, which is how many the app lets through to the
# model. They are different controls and the app has to be the tighter one:
# whichever limit is lower is where requests wait, and only the app's queue is
# instrumented. Set them equal and `app queue wait` reads 0.00s no matter how
# overloaded the service is.
NIMBUS_CONCURRENCY=80

# ── starting configuration ───────────────────────────────────────────────
# Re-derive these on the deployed service. A managed model answers in well
# under a second, where the local tiers took several -- so every latency-shaped
# number calibrated on a laptop is wrong here.
NIMBUS_RESPONSE_CACHE=false
NIMBUS_PREFIX_CACHE=false
NIMBUS_SEMANTIC_CACHE=false
NIMBUS_SYSTEM_PROMPT=LONG
NIMBUS_RETRIEVE_K=4
NIMBUS_MAX_TOKENS=32
NIMBUS_MAX_CONCURRENT=2
NIMBUS_SHED_ABOVE_QUEUE=
