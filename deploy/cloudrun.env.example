# Copy these values into the shell/environment used by deploy.sh.
# Do not commit a populated copy or an admin token.

GOOGLE_CLOUD_PROJECT=replace-with-project-id
GOOGLE_CLOUD_LOCATION=us-central1
NIMBUS_SERVICE=nimbus
NIMBUS_REPOSITORY=nimbus
NIMBUS_RUNTIME_SERVICE_ACCOUNT=nimbus-runtime@replace-with-project-id.iam.gserviceaccount.com
NIMBUS_ADMIN_SECRET=nimbus-admin-token

# Mistral Small 3.1 is the default 24B-class managed model in the adapter.
# Keep the model configurable because managed model availability and pricing
# can change before the workshop.
NIMBUS_GOOGLE_API_STYLE=mistral
NIMBUS_GOOGLE_MODEL_ID=mistral-small-2503

# Cloud Run capacity: one instance with two in-process requests is a good
# starting point for a 10-20 participant workshop. Raise max instances only
# after measuring queue wait and confirming the budget.
NIMBUS_MIN_INSTANCES=1
NIMBUS_MAX_INSTANCES=1
NIMBUS_CONCURRENCY=2
NIMBUS_CPU=1
NIMBUS_MEMORY=1Gi

# Production defaults for this container. These are environment overrides of
# 01_deploy/config.py and are reported by /metrics.
NIMBUS_RESPONSE_CACHE=true
NIMBUS_PREFIX_CACHE=false
NIMBUS_SEMANTIC_CACHE=false
NIMBUS_SYSTEM_PROMPT=TRIMMED
NIMBUS_RETRIEVE_K=3
NIMBUS_MAX_TOKENS=32
NIMBUS_MAX_CONCURRENT=2
NIMBUS_SHED_ABOVE_QUEUE=4
